+! Type-safe adapters for legacy DSS APIs whose buffers are sequences of
+! 32-bit words.  C_LOC/C_F_POINTER preserve the original address and bits.
+subroutine zptrec6_r4(ifltab, iarray, narray, jadd, lsaveb)
+  use iso_c_binding, only: c_float, c_int, c_loc
+  implicit none
+  integer(c_int) :: ifltab(*), narray, jadd
+  real(c_float), target :: iarray(*)
+  logical :: lsaveb
+  call zptrec6_word_address(ifltab, c_loc(iarray(1)), narray, jadd, lsaveb)
+end subroutine zptrec6_r4
+
+subroutine zptrec6_r8(ifltab, iarray, narray, jadd, lsaveb)
+  use iso_c_binding, only: c_double, c_int, c_loc
+  implicit none
+  integer(c_int) :: ifltab(*), narray, jadd
+  real(c_double), target :: iarray(*)
+  logical :: lsaveb
+  call zptrec6_word_address(ifltab, c_loc(iarray(1)), narray, jadd, lsaveb)
+end subroutine zptrec6_r8
+
+subroutine zptrec6_i1(ifltab, iarray, narray, jadd, lsaveb)
+  use iso_c_binding, only: c_int, c_loc
+  implicit none
+  integer(c_int) :: ifltab(*), narray, jadd
+  integer(c_int), target :: iarray
+  logical :: lsaveb
+  call zptrec6_word_address(ifltab, c_loc(iarray), narray, jadd, lsaveb)
+end subroutine zptrec6_i1
+
+subroutine zptrec6_word_address(ifltab, address, narray, jadd, lsaveb)
+  use iso_c_binding, only: c_f_pointer, c_int, c_ptr
+  implicit none
+  integer(c_int) :: ifltab(*), narray, jadd, nwords
+  type(c_ptr), intent(in) :: address
+  integer(c_int), pointer :: words(:)
+  logical :: lsaveb
+  nwords = max(1, narray)
+  call c_f_pointer(address, words, [nwords])
+  call zptrec6(ifltab, words, narray, jadd, lsaveb)
+end subroutine zptrec6_word_address
+
