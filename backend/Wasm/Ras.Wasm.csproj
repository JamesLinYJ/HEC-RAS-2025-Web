<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>Ras.Wasm</AssemblyName>
    <RootNamespace>Ras.Wasm</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);RAS_BROWSER_WASM</DefineConstants>
    <PublishTrimmed>true</PublishTrimmed>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;artifacts/**/*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Source/Ras.Engine/Ras.Engine.csproj" />
    <ProjectReference Include="../Source/Geospatial.Core/Geospatial.Core.csproj" />
    <ProjectReference Include="../Source/Utility.Core/Utility.Core.csproj" />
    <ProjectReference Include="../Source/Utility.Math.x86/Utility.Math.x86.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="NativeProgram.cs" />
    <Content Remove="artifacts/**;artifacts/**/*" />
    <None Remove="artifacts/**;artifacts/**/*" />
    <EmbeddedResource Remove="artifacts/**;artifacts/**/*" />
  </ItemGroup>
</Project>
